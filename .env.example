# NapCat 正向 WebSocket 地址
WS_URL=ws://127.0.0.1:3001
# NapCat 配置了 token 时填写同一个值；监听 0.0.0.0 时通常强制要求 token
WS_TOKEN=
# 机器人自己的 QQ 号（与 NapCat 登录号一致）
BOT_QQ=10000
# 管理员 QQ（唯一允许私聊的人）
ADMIN_QQ=123456
# 允许的群号，逗号分隔
ALLOWED_GROUPS=123456789
# 可选：机器人昵称，留空则启动后从 get_login_info 获取
BOT_NAME=

# LLM（OpenAI 兼容接口）
LLM_API_KEY=sk-xxx
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-flash

# 可选运行参数
# SUMMARY_HOUR 同时是定时总结时间和上下文“逻辑日界”（默认凌晨 3 点）
DATA_DIR=./data
TZ_NAME=Asia/Shanghai
SUMMARY_HOUR=3
SUMMARY_THRESHOLD=200
