# NapCat 正向 WebSocket
# 单机直接运行用 ws://127.0.0.1:3001；compose 里会被覆盖成 ws://napcat:3001
WS_URL=ws://127.0.0.1:3001
# NapCat 配置的 OneBot WS token；两边必须一致
WS_TOKEN=
# Podman Compose：NapCat WebUI 登录口令（首次初始化用）
NAPCAT_WEBUI_TOKEN=change-me
# 可选：NapCat 容器运行 UID/GID；rootful Podman 默认 0
# NAPCAT_UID=0
# NAPCAT_GID=0
# 机器人自己的 QQ 号（与 NapCat 登录号一致）
BOT_QQ=10000
# 管理员 QQ（唯一允许私聊的人）
ADMIN_QQ=123456
# 允许的群号，逗号分隔
ALLOWED_GROUPS=123456789
# 可选：机器人昵称，留空则启动后从 get_login_info 获取
BOT_NAME=

# LLM（OpenAI 兼容接口）
LLM_API_KEY=sk-xxx
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-flash

# 可选运行参数
# SUMMARY_HOUR 同时是定时总结时间和上下文“逻辑日界”（默认凌晨 3 点）
DATA_DIR=./data
TZ_NAME=Asia/Shanghai
SUMMARY_HOUR=3
SUMMARY_THRESHOLD=200

# P1 主动发言（默认关闭；开启后只在满足空闲/冷却/概率时插话）
PROACTIVE_ENABLED=0
PROACTIVE_CHANCE=0.05
PROACTIVE_IDLE_MS=600000
PROACTIVE_COOLDOWN_MS=1800000
PROACTIVE_MAX_PER_HOUR=3
PROACTIVE_MIN_TEXT_LENGTH=6
# PROACTIVE_GROUPS=123456789

# 日志（默认同时输出控制台和 data/runtime/logs，按天轮转）
LOG_LEVEL=info
# LOG_DIR=./data/runtime/logs
# LOG_TO_FILE=1
# LOG_RETENTION_DAYS=7

# 角色与语料库同级，默认都在 data/ 下
CHARACTERS_DIR=./data/characters
CORPORA_DIR=./data/corpora
# 下面是派生路径，通常不用改
# ACTIVE_CHARACTER_FILE=./data/runtime/active-character.txt
